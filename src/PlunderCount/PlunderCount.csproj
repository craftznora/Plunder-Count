<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows app: the standby process has no window; the tool opens its own console (NativeConsole). -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>PlunderCount</AssemblyName>
    <RootNamespace>PlunderCount</RootNamespace>
    <Version>1.1.0</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Single-file publish: the parser discovers its types by reflection, so no trimming. -->
    <PublishTrimmed>false</PublishTrimmed>
    <!-- Small idle footprint: workstation, non-concurrent GC (no background GC thread) and a GC that gives memory back. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- Plunder Count mark: icon of the exe, its console window and the tray. -->
    <ApplicationIcon>Assets\PlunderCount.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
    <!-- GDI+ (Windows only): anti-aliased, per-pixel alpha drawing of the overlay. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- What's new of this version: shown once after an update, and used as the GitHub release text (build.yml). -->
    <EmbeddedResource Include="..\..\RELEASE_NOTES.md" LogicalName="ReleaseNotes.md" />
  </ItemGroup>
</Project>
